INDUSTRY_ENVIRONMENT=local
INDUSTRY_API_TOKEN=replace-with-a-random-token-at-least-32-characters
INDUSTRY_DATABASE_URL=sqlite:///data/platform.db
INDUSTRY_DATA_DIR=data
INDUSTRY_CRAWLER_ADAPTER=integrated
INDUSTRY_CORS_ORIGINS=[]
INDUSTRY_POLL_INTERVAL_S=1
INDUSTRY_LEASE_SECONDS=120
INDUSTRY_CODE_VERSION=0.1.0
# PostgreSQL example (create the database and run migrations before starting):
# INDUSTRY_DATABASE_URL=postgresql+psycopg://industry:password@127.0.0.1:5432/industry
# Adapter format: your_package.your_module:create_adapter
INDUSTRY_TASK_BACKEND=database
INDUSTRY_REDIS_URL=redis://127.0.0.1:6379/0
INDUSTRY_BRIDGE_TIMEOUT_S=600
INDUSTRY_ADVISOR_API_KEY=
INDUSTRY_ADVISOR_BASE_URL=https://api.deepseek.com
INDUSTRY_ADVISOR_MODEL=deepseek-flash
INDUSTRY_ADVISOR_TIMEOUT_S=60
INDUSTRY_ADVISOR_MAX_TOKENS=2000
